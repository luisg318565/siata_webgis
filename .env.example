# --- Base de datos espacial (PostGIS) ---
POSTGRES_USER=siata_user
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=siata_geoespacial
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cadena de conexión que consume el backend
DATABASE_URL=postgresql+psycopg://siata_user:cambiar_en_produccion@db:5432/siata_geoespacial

# --- GeoServer ---
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=cambiar_en_produccion
GEOSERVER_WORKSPACE=siata
GEOSERVER_DATASTORE=postgis_coberturas
GEOSERVER_LAYER=coberturas

# --- URLs públicas (cambian en despliegue AWS) ---
# En local: localhost. En AWS: la IP pública de la instancia.
PUBLIC_HOST=localhost